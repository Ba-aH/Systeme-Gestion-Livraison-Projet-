<script>
    // Fetching data of the bell nb livraison et livraisons
    fetch('{{ path('dashboardExtend') }}')
    .then(response => response.json())
    .then(data => {
        // Update notification count in the HTML
        const notificationCountElement = document.getElementById('notification-count');
        if (notificationCountElement) {
            notificationCountElement.textContent = data.nbLivraisons;
        }

        // Get the container where reference items will be appended
        const notificationList = document.getElementById('notification-list');

        // Iterate through the livraisons array and append reference items
        data.livraisons.forEach(livraison => {
            const referenceItem = document.createElement('div');
            referenceItem.innerHTML = `
                <div class="notification-item-wrapper">
                    <i class="bi bi-exclamation-circle text-warning"></i>
                    <div>
                        <h4>Reference de livraison: ${livraison.reference}</h4>
                        <p>Region: ${livraison.region} </p>
                        <p>Doit étre livré en: ${livraison.date}</p>
                    </div>
                </div>
            `;
            notificationList.appendChild(referenceItem);
        });
    })
    .catch(error => {
        console.error('Error fetching data:', error);
    });
</script>
