
{% extends 'base.html.twig' %}
 {% block body %}



   

<body>
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <!-- =============== Navigation ================ -->
    <div class="container">
        <div class="navigation">
            <ul>
                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="logo-apple"></ion-icon>
                        </span>
                        <span class="title">Brand Name</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_administrator') }}">
                        <span class="icon">
                            <ion-icon name="home-outline"></ion-icon>
                        </span>
                        <span class="title">Dashboard</span>
                    </a>
                </li>

                <li>
                    <a href="">
                        <span class="icon">
                            <ion-icon name="people-outline"></ion-icon>
                        </span>
                        <span class="title">Customers</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_gerer_tour') }}">
                        <span class="icon">
                            <ion-icon name="chatbubble-outline"></ion-icon>
                        </span>
                        <span class="title">Messages</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="help-outline"></ion-icon>
                        </span>
                        <span class="title">Help</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="settings-outline"></ion-icon>
                        </span>
                        <span class="title">Settings</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="lock-closed-outline"></ion-icon>
                        </span>
                        <span class="title">Password</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="log-out-outline"></ion-icon>
                        </span>
                        <span class="title">Sign Out</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- ========================= Main ==================== -->
        <div class="main">
            <div class="topbar">
                <div class="toggle">
                    <ion-icon name="menu-outline"></ion-icon>
                </div>

                <div class="search">
                    <label>
                        <input type="text" placeholder="Search here">
                        <ion-icon name="search-outline"></ion-icon>
                    </label>
                </div>

                <div class="user">
                    <img src="assets/imgs/customer01.jpg" alt="">
                </div>
            </div>

            <!-- ======================= Cards ================== -->
            <div class="cardBox">
            
                <div class="card">
                    <div>
                        <div class="numbers">{{nb}}</div>
                        <div class="cardName">Livraisons</div>
                    </div>

                    <div class="iconBx">
                        <ion-icon name="cart-outline"></ion-icon>
                    </div>
                </div>


                <div class="card">
                    <div>
                        <div class="numbers">${{prix}}</div>
                        <div class="cardName">Revenus</div>
                    </div>

                    <div class="iconBx">
                        <ion-icon name="cash-outline"></ion-icon>
                    </div>
                </div>
            </div>

    
            <div class="details">
                <div class="recentOrders">
                    <div class="cardHeader">
                        <h2> Choisie la méthode de filtrage pour l'historique des livraisons</h2>
                        <a href="#" class="btn">View All</a> 
                    </div>

                    <form id="myForm" method="post" action="{{ path('history', {'region': 'default', 'coursier': 'default', 'date':'default'}) }}" onsubmit="updateFormAction()">
                        <label for="coursier" style='font-weight: bold;'>Coursier Username:</label>
                        <input type="text" id="coursier" name="coursier">
                        
                        <label for="date" style='font-weight: bold;'>Select a Date :</label>
                        <input type="date" id="date" name="date">
                        
                        <label for="region" style='font-weight: bold;'>Select Region:</label>
                        <select id="region" name="region">
                            <option value="" disabled selected>Select a region</option>
                            <option value="Grand Tunis">Grand Tunis</option>
                            <option value="Nord-Est">Nord-Est</option>
                            <option value="Nord-Ouest">Nord-Ouest</option>
                            <option value="Centre-Est">Centre-Est</option>
                            <option value="Centre-Ouest">Centre-Ouest</option>
                            <option value="Sud-Est">Sud-Est</option>
                            <option value="Sud-Ouest">Sud-Ouest</option>
                        </select>
                        <input type="submit" value="Lister">
                    </form>
                    
                        <h3>{{display}}</h3>
                    

                    <script>
                        function updateFormAction() {
                            var selectedRegion = document.getElementById('region').value;
                            var selectedCoursier = document.getElementById('coursier').value;
                            var selectedDate = document.getElementById('date').value;
                            document.getElementById('myForm').action = "{{ path('history', {'region': ''}) }}" + selectedRegion + "&coursier=" + selectedCoursier+"&date=" +selectedDate;
                            return true; 
                        }
                    </script>

                <style>
                   .cardBox {
                        display: flex;
                        justify-content: center;
                        
                    }
                    .card {
                        width: 280px; /* Adjust the width as needed */
                        margin: 0 10px; /* Add some margin between the cards if desired */
                        
                    }

                    label {                     
                        margin-bottom: 8px;
                    }

                    input[type="text"],
                    input[type="date"],
                    select {
                        padding: 8px;
                        
                    }

                    select {
                        margin-bottom: 20px;
                    }

                    input[type="submit"] {
                        background-color: var(--blue);
                        color: white;
                        padding: 10px 15px;
                        border: none;
                        border-radius: 3px;
                        cursor: pointer;
                    }

                    input[type="submit"]:hover {
                        background-color: var(--blue);
                    }

                    
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                    }

                    thead {
                        background-color: #f2f2f2;
                    }

                    thead, td {
                        border: 1px solid #ddd;
                        padding: 8px;
                        text-align: left;
                    }

                    td {
                        height: 40px;
                    }

                    

                    tr:hover {
                        background-color: #f1f1f1;
                    }

                      
                </style>


                
                    <table>
                        <thead>
                            <tr>
                                <td>Reference de livraison</td>
                                <td>Client Email</td>
                                <td>Frais livraison</td>
                                <td>Poid en kg</td>
                               
                            </tr>
                        </thead>
                      {% for history in livraisons %}
                        <tr>
                            <td>{{ history.livraison.reference }}</td>
                            <td>{{ history.livraison.client.email  }}</td>
                            <td>${{ history.livraison.prixTotaleLivraison }}</td>
                            <td>{{ history.livraison.poidLivraison  }} kg</td>                           
                        </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8">no records found</td>
                                </tr>
                            {% endfor %}
                    </table>
                </div>

                <div class="recentCustomers">
                    <div class="cardHeader">
                        <h2>Coursiers liste</h2>
                    </div>

                    <table>
                        {% for coursier in coursiers %}
                        <tr>
                            <td width="60px">
                                <div class="imgBx"><img src={{ asset('assets/imgs/coursiers.png')}}></div>
                            </td>
                            <td>
                                <h4>{{ coursier.username }} <br> <span>{{ coursier.nom }} {{ coursier.prenom }}</span></h4>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="2">No records found</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
 
                
            </div>
  
            



  
            
            

   <!-- =========== Scripts =========  -->
    <script src="assets/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    <script src="assets/js/chartsJS.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script src={{ asset('assets/js/main.js')}}></script>
    <script src={{ asset('assets/js/chartsJS.js')}}></script>
</body>
</html>

  {% endblock %}