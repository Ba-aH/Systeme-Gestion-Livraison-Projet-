
{% extends 'base.html.twig' %}
 {% block body %}



   

<body>
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <!-- =============== Navigation ================ -->
    <div class="container">
        <div class="navigation">
           <ul>
                <li>
                    <a href="">
                        <span class="icon">
                            <ion-icon name="logo-apple"></ion-icon>
                        </span>
                        <span class="title">Brand Name</span>
                    </a>
                </li>

                <li>
                      <a href="{{ path('app_administrator') }}">
                        <span class="icon">
                            <ion-icon name="home-outline"></ion-icon>
                        </span>
                        <span class="title">Dashboard</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_colis_index') }}">
                        <span class="icon">
                            <ion-icon name="people-outline"></ion-icon>
                        </span>
                        <span class="title">Customers</span>
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_gerer_tour') }}">
                        <span class="icon">
                            <ion-icon name="chatbubble-outline"></ion-icon>
                        </span>
                        <span class="title">affecter livraisons</span>
                    </a>
                </li>

                <li>
                  <a href="{{ path('echec') }}">
                        <span class="icon">
                            <ion-icon name="help-outline"></ion-icon>
                        </span>
                        <span class="title">livraison echouée</span>
                    </a>
                </li>

                <li> 
                    <a href="{{ path('coursiers') }}">       
                       <span class="icon">
                            <ion-icon name="people-outline"></ion-icon>
                        </span>
                        {# <span class="icon">
                            <ion-icon name="settings-outline"></ion-icon>
                        </span> #}
                        <span class="title">coursier</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="lock-closed-outline"></ion-icon>
                        </span>
                        <span class="title">Password</span>
                    </a>
                </li>

                <li>
                    <a href="#">
                        <span class="icon">
                            <ion-icon name="log-out-outline"></ion-icon>
                        </span>
                        <span class="title">Sign Out</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- ========================= Main ==================== -->
        <div class="main">
            <div class="topbar">
                <div class="toggle">
                    <ion-icon name="menu-outline"></ion-icon>
                </div>

                <div class="search">
                    <label>
                        <input type="text" placeholder="Search here">
                        <ion-icon name="search-outline"></ion-icon>
                    </label>
                </div>

                <div class="user">
                    <img src="assets/imgs/customer01.jpg" alt="">
                </div>
            </div>

            <!-- ======================= Cards ================== -->
            <div class="cardBox">
            
                <div class="card">
                    <div>
                        <div class="numbers">{{nbLivraisons}}</div>
                        <div class="cardName">Livraisons</div>
                    </div>

                    <div class="iconBx">
                        <ion-icon name="cart-outline"></ion-icon>
                    </div>
                </div>


                <div class="card">
                    <div>
                        <div class="numbers">{{prixTotale}}</div>
                        <div class="cardName">Revenus</div>
                    </div>

                    <div class="iconBx">
                        <ion-icon name="cash-outline"></ion-icon>
                    </div>
                </div>
            </div>

    
            <div class="details">
                <div class="recentOrders">
                    <div class="cardHeader">
                        <h2>Les nouvelles livraisons sont maintenant disponibles et doivent être attribuées au coursier disponible.</h2>                   
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <td>Reference de livraison</td>
                                <td>Date livraison</td>
                                <td>Prix livraison</td>
                                <td>Poid</td>
                            </tr>   
                        </thead>

                        <tbody>
                        {% for livraison in livraisons %}
                            <tr class="hoverable-tr">
                            <td>{{ livraison.reference }}</td>
                            <td>{{ livraison.livraisonDate ? livraison.livraisonDate|date('Y-m-d') : '' }}</td>
                            <td>{{ livraison.prixTotaleLivraison }}</td>                 
                            <td>{{ livraison.poidLivraison }}</td>
                            <td>
                            <a href="{{ path('app_couriers', {'id': livraison.Client.id, 'livraisonId': livraison.id}) }}" class="add-to-tour-link">Vérifier le courrier disponible</a>
                            </td>
                        </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8">no records found</td>
                                </tr>
                            {% endfor %}

                        
                    </table>
                </div>
                <div class="recentCustomers">
                    <div class="cardHeader">
                        <h2>Coursiers liste</h2>
                    </div>

                    <table>
                        {% for coursier in coursiers %}
                        <tr>
                            <td width="10px">
                                <div class="imgBx"><img src={{ asset('assets/imgs/coursiers.png')}}></div>
                            </td>
                            <td>
                                <h4>{{ coursier.username }} <br> <span>{{ coursier.nom }} {{ coursier.prenom }}</span></h4>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="2">No records found</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
                
            </div>


            <style>
            .add-to-tour-link {
                color: var(--blue); 
                text-decoration: none; 
                font-weight: bold; 
                
            }
            .hoverable-tr:hover .add-to-tour-link {
                color: #ffffff; /* Change the color to white on td hover */
            }


            .cardBox {
                display: flex;
                justify-content: center;
                        
             }
            .card {
                width: 280px; /* Adjust the width as needed */
                margin: 0 10px; /* Add some margin between the cards if desired */            
             }

            input[type="submit"] {
                        background-color: var(--blue);
                        color: white;
                        padding: 10px 15px;
                        border: none;
                        border-radius: 3px;
                        cursor: pointer;
                    }

            input[type="submit"]:hover {
             background-color: var(--blue);
            }
                
            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 20px;
                }

            thead {
                background-color: #f2f2f2;
            }

            thead, td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }

            td {
                height: 40px;
            }

            tr:hover {
                background-color: #f1f1f1;
            }

            </style>



  

            
            

   <!-- =========== Scripts =========  -->
    <script src="assets/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    <script src="assets/js/chartsJS.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</body>
</html>
<script src={{ asset('assets/js/main.js')}}></script>
<script src={{ asset('assets/js/chartsJS.js')}}></script>
  {% endblock %}