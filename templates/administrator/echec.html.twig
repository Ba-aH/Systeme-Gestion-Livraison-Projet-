   <script>
    function populateForm(reference, id, codePin, fraisLivraison, prixTotaleLivraison, poidLivraison, livraisonDate, tournerId) {
        localStorage.setItem('reference', reference);
        localStorage.setItem('id', id);
        localStorage.setItem('codepin', codePin);
        localStorage.setItem('fraisLivraison', fraisLivraison);
        localStorage.setItem('prixTotaleLivraison', prixTotaleLivraison);
        localStorage.setItem('poidLivraison', poidLivraison);
        localStorage.setItem('livraisonDate', livraisonDate);
    
            localStorage.setItem('tournerId', tournerId);
       

           document.getElementById('reference').value = reference;
        document.getElementById('ids').value = id;
        document.getElementById('codepin').value = codePin;
        document.getElementById('fraix').value = fraisLivraison;
        document.getElementById('prix').value = prixTotaleLivraison;
        document.getElementById('poid').value = poidLivraison;
       
        
            document.getElementById('tourner').value = tournerId;
    
        
    }
</script>
