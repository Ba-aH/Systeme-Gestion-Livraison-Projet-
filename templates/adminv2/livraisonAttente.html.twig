{% extends 'adminv2.html.twig' %}
 {% block body %}

<body>
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <!-- Include Leaflet Routing Machine CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css" />
 

  <main id="main" class="main">

    <div class="pagetitle">
      <h1>Dashboard</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="index.html">Home</a></li>
          <li class="breadcrumb-item active">Livraisons en attente  </li>
         
        </ol>
      </nav>
    </div><!-- End Page Title -->
 <table class="table table-hover">
                <thead>
                  <tr>
                  
                    <th scope="col">Reference</th>
                    <th scope="col">Date</th>
                  
                    <th scope="col">prix</th>
                      <th scope="col">Poid</th>
                    <th scope="col">Action</th> 
                  </tr>
                </thead>
                <tbody>
                  {% for livraison in livraisons  %}
                  <tr>
                    <td>{{ livraison.reference }}</td>
                    <td>{{ livraison.livraisonDate ? livraison.livraisonDate|date('Y-m-d') : '' }}</td>
                    <td>{{ livraison.prixTotaleLivraison }}</td>
                    <td>{{ livraison.poidLivraison}}</td>

                    <td><a class ="modifier" href="{{ path('app_couriers', {'id': livraison.Client.id, 'livraisonId': livraison.id}) }}">Verifier les coursier disponible</a></td>
                  </tr>
                 
                      {% endfor %}
                </tbody>
              </table>
  </main><!-- End #main -->

<div id="map" style="width:100%; height: 100vh"></div>
	<script src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js"></script>
	<script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
<style> 
  .modifier {
      display: inline-block;
      padding: 10px 20px;
      text-decoration: none;
      color: white;
      background-color: blue;
      border: 1px solid blue;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s, color 0.3s; /* Add transition for smooth effect */
  }

  .modifier:hover {
      background-color: white;
      color: blue;
  }
</style>
 <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <!-- Include Leaflet Routing Machine JS -->
  <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

<script>
    var coordinates;
    var map = L.map('map').setView([36.806389, 10.181667], 10);
    var marker = L.marker([36.86014, 10.19347]).addTo(map);
    mapLink = "<a href='http://openstreetmap.org'>OpenStreetMap</a>";
    L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', { attribution: 'Leaflet &copy; ' + mapLink + ', contribution', maxZoom: 18 }).addTo(map); 
  var routeControl = L.Routing.control({
            waypoints: [
                L.latLng(36.86014, 10.19347), // First coordinate
           
                L.latLng(37.118716, 10.005798)
            ]
        }).addTo(map);
         function calculateDistance(pointA, pointB) {
         return pointA.distanceTo(pointB);
    }
  function updateVehicleLocation(newLat,newLng) {
    var newCoordinates = L.latLng(newLat, newLng);

      marker.setLatLng(newCoordinates);

      
      routeControl.setWaypoints([
        newCoordinates,
        L.latLng(37.118716, 10.005798)
      ]);

        var currentLocation = marker.getLatLng();
      var destinationLocation = L.latLng(37.118716, 10.005798);
      var distance = calculateDistance(currentLocation, destinationLocation);

      if (distance < 100) {


           
        alert("Vehicle is less than 100 meters away from the destination!"+distance);


      }
      
    }


    const url = new URL('http://localhost:3000/hub');
    url.searchParams.append('topic', 'http://monsite.com/user');
    const eventSource = new EventSource(url);
    eventSource.onmessage = e => { 
        const data = JSON.parse(e.data);
        var data2 = {
                positionHistoryLat: data.positionHistoryLat,
                positionHistoryLong: data.positionHistoryLong,
                coursier: data.coursier,
                tourner: data.tourner
            };  

            $.ajax({
                type: 'POST',
                url: '{{ path('addLocationHistory') }}',
                data: data2,
                success: function(response) {
                    console.log('Address added successfully.');
                },
                error: function(xhr, status, error) {
                    console.error('Error adding address:', error);
                }
            });
              updateVehicleLocation(data.positionHistoryLat, data.positionHistoryLong); 
        // marker.setLatLng([data.positionHistoryLat, data.positionHistoryLong]); 
        console.log(data);
        document.querySelector('h1').insertAdjacentHTML('afterend','<div class= "alert alert-success">Ping !</div>')
        window.setTimeout(() => {
            const $alert = document.querySelector('.alert')
            $alert.parentNode.removeChild($alert)
        }, 2000)

        
    }
    </script>
    
    


  {% endblock %}

  