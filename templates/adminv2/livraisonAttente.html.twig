{% extends 'adminv2.html.twig' %}
 {% block body %}

<body>
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <!-- Include Leaflet Routing Machine CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css" />
 

  <main id="main" class="main">

    <div class="pagetitle">
      <h1>Dashboard</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="index.html">Home</a></li>
          <li class="breadcrumb-item active">Livraisons en attente  </li>
         
        </ol>
      </nav>
    </div><!-- End Page Title -->
 <table class="table table-hover">
                <thead>
                  <tr>
                  
                    <th scope="col">Reference</th>
                    <th scope="col">Date</th>
                  
                    <th scope="col">prix</th>
                      <th scope="col">Poid</th>
                    <th scope="col">Action</th> 
                  </tr>
                </thead>
                <tbody>
                  {% for livraison in livraisons  %}
                  <tr>
                    <td>{{ livraison.reference }}</td>
                    <td>{{ livraison.livraisonDate ? livraison.livraisonDate|date('Y-m-d') : '' }}</td>
                    <td>{{ livraison.prixTotaleLivraison }}</td>
                    <td>{{ livraison.poidLivraison}}</td>

                    <td><a class ="modifier" href="{{ path('app_couriers', {'id': livraison.Client.id, 'livraisonId': livraison.id}) }}">Verifier les coursier disponible</a></td>
                    
                    <td>
                      <button type="button" class="modifier fetchCouriersBtn" data-toggle="modal" data-target="#exampleModalCenter" data-livraison-id="{{ livraison.id }}">
                        Verifier les coursier disponible
                      </button>


                      <!-- Modal -->
                      <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title" id="exampleModalLongTitle">Liste des courier disponible a Nord-Est <br>En 2024-04-12</h5>
                             
                            </div>
                            <div class="modal-body">
                              <table class="table table-hover">
                                <thead>
                                  <tr>
                                    <th scope="col">Email</th>
                                    <th scope="col">Nom</th>
                                    <th scope="col">Prenom</th>
                                    <th scope="col">Action</th> 
                                  </tr>
                                </thead>
                                <tbody>
                                  <tr>
                                    
                                    {# {% set livraisonId = app.request.query.get('livraisonId') %} #}
                                    {# <td><a href="{{ path('affectRoute', {'id': courier.coursier.id, 'livraisonId': livraisonId}) }}" class ="modifier" >Ajouter à sa tournée</a></td> #}
                                  </tr>  
                                </tbody>
                              </table>
                            </div>
                            <script>
                            const fetchCouriersBtns = document.querySelectorAll('.fetchCouriersBtn');

                            // Add click event listener to each button
                            fetchCouriersBtns.forEach(button => {
                              button.addEventListener('click', () => {
                                // Extract livraison ID from the button's data attribute
                                const livraisonId = button.dataset.livraisonId;

                                fetch(`https://127.0.0.1:8000/administrator/availableCouriers/${livraisonId}`) // Pass livraison ID in the URL
                                  .then(response => response.json())
                                  .then(data => {
                                    // Data received from the server
                                    console.log(data);

                                    // Now you can manipulate the DOM to display the data
                                    // For example, if you want to populate a table with the data
                                    const modalBody = document.querySelector('#exampleModalCenter .modal-body table tbody');

                                    // Clear existing table rows
                                    modalBody.innerHTML = '';

                                    data.forEach(courier => {
                                      const row = document.createElement('tr');
                                      row.innerHTML = `
                                        <td>${courier.coursier.email}</td>
                                        <td>${courier.coursier.nom}</td>
                                        <td>${courier.coursier.prenom}</td>
                                        <td>
                                          <a href="#">Add to tour</a>
                                        </td>
                                      `;
                                      modalBody.appendChild(row);
                                    });
                                  })
                                  .catch(error => {
                                    console.error('Error:', error);
                                  });
                              });
                            });
                            </script>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                              <button type="button" class="btn btn-primary">Save changes</button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                 
                      {% endfor %}
                </tbody>
              </table>
          
              
          

          <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
          <!-- Include Bootstrap JavaScript -->
          <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </main><!-- End #main -->

<style> 
  .modifier {
      display: inline-block;
      padding: 10px 20px;
      text-decoration: none;
      color: white;
      background-color: blue;
      border: 1px solid blue;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s, color 0.3s; /* Add transition for smooth effect */
  }

  .modifier:hover {
      background-color: white;
      color: blue;
  }
</style>
 <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <!-- Include Leaflet Routing Machine JS -->
  <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

<script>
    const url = new URL('http://localhost:3000/hub');
    url.searchParams.append('topic', 'http://monsite.com/user');
    const eventSource = new EventSource(url);
    eventSource.onmessage = e => { 
        const data = JSON.parse(e.data);
        var data2 = {
                positionHistoryLat: data.positionHistoryLat,
                positionHistoryLong: data.positionHistoryLong,
                coursier: data.coursier,
                tourner: data.tourner
            };  

            $.ajax({
                type: 'POST',
                url: '{{ path('addLocationHistory') }}',
                data: data2,
                success: function(response) {
                    console.log('Address added successfully.');
                },
                error: function(xhr, status, error) {
                    console.error('Error adding address:', error);
                }
            });
              updateVehicleLocation(data.positionHistoryLat, data.positionHistoryLong); 
        // marker.setLatLng([data.positionHistoryLat, data.positionHistoryLong]); 
        console.log(data);
        document.querySelector('h1').insertAdjacentHTML('afterend','<div class= "alert alert-success">Ping !</div>')
        window.setTimeout(() => {
            const $alert = document.querySelector('.alert')
            $alert.parentNode.removeChild($alert)
        }, 2000)    
    }
      $('#myModal').on('shown.bs.modal', function () {
      $('#myInput').trigger('focus')
    })
    </script>
    
    


  {% endblock %}

  