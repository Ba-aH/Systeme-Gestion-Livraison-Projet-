{% extends 'adminv2.html.twig' %}
 {% block body %}

<body>
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <!-- Include Leaflet Routing Machine CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.css" />
 

  <main id="main" class="main">

    <div class="pagetitle">
      <h1>Affecter les livraisons</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="index.html">Home</a></li>
          <li class="breadcrumb-item active">Affecter livraisons  </li>
         
        </ol>
      </nav>
    </div><!-- End Page Title -->
        <table class="table table-hover">
                <thead>
                  <tr>
                  
                    <th scope="col">Reference</th>
                    <th scope="col">Date</th>
                  
                    <th scope="col">prix</th>
                      <th scope="col">Poid</th>
                    <th scope="col">Action</th> 
                  </tr>
                </thead>
                <tbody>
                {% for livraison in livraisons %}
            <tr>
                <td>{{ livraison.reference }}</td>
                <td>{{ livraison.livraisonDate ? livraison.livraisonDate|date('Y-m-d') : '' }}</td>
                <td>{{ livraison.prixTotaleLivraison }}</td>
                <td>{{ livraison.poidLivraison }}</td>

                {# <td>
                    <a class="modifier" href="{{ path('app_couriers', {'id': livraison.Client.id, 'livraisonId': livraison.id}) }}">Verifier les coursiers disponibles</a>
                </td> #}
                       
                <td>
                    {% if livraison.availableCouriers is not empty %}
                        <button type="button" class="modifier fetchCouriersBtn" data-toggle="modal" data-target="#exampleModalCenter{{ livraison.id }}" data-livraison-id="{{ livraison.id }}">
                            Verifier les coursiers disponibles
                        </button>
                    {% else %}
                        <a style="color: red;" href="#">Aucun coursier n'est disponible</a>
                    {% endif %}
                    <!-- Modal -->
                    <div class="modal fade" id="exampleModalCenter{{ livraison.id }}" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLongTitle">Liste des couriers disponibles à {{ livraison.getLivraisonRegion(adresseRepository) }} <br> en {{ livraison.livraisonDate ? livraison.livraisonDate|date('Y-m-d') : '' }}</h5>
                                </div>
                                <div class="modal-body">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th scope="col">Email</th>
                                                <th scope="col">Nom</th>
                                                <th scope="col">Prenom</th>
                                                <th scope="col">Action</th> 
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for coursier in livraison.availableCouriers %}
                                            <tr>
                                                {% if coursier is not null %}
                                                    <td>{{ coursier.email }}</td>
                                                    <td>{{ coursier.nom }}</td>
                                                    <td>{{ coursier.prenom }}</td>
                                                <td>
                                                    <a href="{{ path('affectRoute', {'id': coursier.id, 'livraisonId': livraison.id}) }}">Add to tour</a>
                                                </td>
                                                {% endif %}
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                    <button type="button" class="btn btn-primary">Save changes</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
                
                
            </tr>
            {% endfor %}
            </tbody>
        </table>
          
              
          

          <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
          <!-- Include Bootstrap JavaScript -->
          <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </main><!-- End #main -->

<style> 
  .modifier {
      display: inline-block;
      padding: 10px 20px;
      text-decoration: none;
      color: white;
      background-color: blue;
      border: 1px solid blue;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s, color 0.3s; /* Add transition for smooth effect */
  }

  .modifier:hover {
      background-color: white;
      color: blue;
  }
</style>
 <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <!-- Include Leaflet Routing Machine JS -->
  <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

<script>
    const url = new URL('http://localhost:3000/hub');
    url.searchParams.append('topic', 'http://monsite.com/user');
    const eventSource = new EventSource(url);
    eventSource.onmessage = e => { 
        const data = JSON.parse(e.data);
        var data2 = {
                positionHistoryLat: data.positionHistoryLat,
                positionHistoryLong: data.positionHistoryLong,
                coursier: data.coursier,
                tourner: data.tourner
            };  

            $.ajax({
                type: 'POST',
                url: '{{ path('addLocationHistory') }}',
                data: data2,
                success: function(response) {
                    console.log('Address added successfully.');
                },
                error: function(xhr, status, error) {
                    console.error('Error adding address:', error);
                }
            });
              updateVehicleLocation(data.positionHistoryLat, data.positionHistoryLong); 
        // marker.setLatLng([data.positionHistoryLat, data.positionHistoryLong]); 
        console.log(data);
        document.querySelector('h1').insertAdjacentHTML('afterend','<div class= "alert alert-success">Ping !</div>')
        window.setTimeout(() => {
            const $alert = document.querySelector('.alert')
            $alert.parentNode.removeChild($alert)
        }, 2000)    
    }
      $('#myModal').on('shown.bs.modal', function () {
      $('#myInput').trigger('focus')
    })
    </script>
    
    


  {% endblock %}

  