{% extends 'adminv2.html.twig' %}
 {% block body %}

<body>

 

  <main id="main" class="main">

   <div class="pagetitle">
      <h1>Profile</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="index.html">Home</a></li>
   
          <li class="breadcrumb-item active">Profile</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section profile">
      <div class="row">
        <div class="col-xl-4">

          <div class="card">
            <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">

         <h2>{{ admin.nom }} {{ admin.prenom | trim }}</h2>
              <h3>Administrateur</h3>
              <div class="social-links mt-2">
                <a href="https://twitter.com/" class="twitter"><i class="bi bi-twitter"></i></a>
                <a href="https://www.facebook.com/" class="facebook"><i class="bi bi-facebook"></i></a>
                <a href="https://www.instagram.com/" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="https://www.linkedin.com/" class="linkedin"><i class="bi bi-linkedin"></i></a>
              </div>
            </div>
          </div>

        </div>

        <div class="col-xl-8">

          <div class="card">
            <div class="card-body pt-3">
              <!-- Bordered Tabs -->
              <ul class="nav nav-tabs nav-tabs-bordered">

                <li class="nav-item">
                  <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-overview">Overview</button>
                </li>

                <li class="nav-item">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-edit">Editer le profil</button>
                </li>

                <li class="nav-item">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-settings">Changer le mot de passe</button>
                </li>

              

              </ul>
              <div class="tab-content pt-2">

                <div class="tab-pane fade show active profile-overview" id="profile-overview">
                  <h5 class="card-title">À propos</h5>
                  <p class="small fst-italic">L'utilisateur {{ admin.nom }} {{ admin.prenom | trim }}, avec le nom d'utilisateur {{ admin.username }}, est un membre précieux de notre equipe de travail.  avec l'e-mail  {{ admin.email }} et le numéro de téléphone {{ admin.phone }}.</p>

                  <h5 class="card-title">Détails du profil</h5>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label ">Nom et prénom</div>
                    <div class="col-lg-9 col-md-8"> {{ admin.nom }} {{ admin.prenom | trim }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Company</div>
                    <div class="col-lg-9 col-md-8">ich</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">username</div>
                    <div class="col-lg-9 col-md-8">{{ admin.username }}</div>
                  </div>

                

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Phone</div>
                    <div class="col-lg-9 col-md-8">{{ admin.phone }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Email</div>
                    <div class="col-lg-9 col-md-8">{{ admin.email }}</div>
                  </div>

                </div>

                <div class="tab-pane fade profile-edit pt-3" id="profile-edit">

                  <!-- Profile Edit Form -->
                    <form id="myForm" class="form" method="POST" action="{{ path('updateadamin', {'nom': 'default', 'prenom': 'default', 'username':'default', 'phone':'default'}) }}" onsubmit="updateFormAction()">
                    <div class="row mb-3">
                        <label for="fullName" class="col-md-4 col-lg-3 col-form-label">nom d'utilisateur</label>
                        <div class="col-md-8 col-lg-9 position-relative">
                            <input type="text" class="form-control" id="usernameInput" value="{{ admin.username }}" readonly>
                            <button class="btn btn-outline-secondary position-absolute end-0 translate-middle-y" type="button" id="editUsernameBtn">Edit</button>
                        </div>
                    </div>

                  

                    <div class="row mb-3">
                      <label for="company" class="col-md-4 col-lg-3 col-form-label">nom</label>
                      <div class="col-md-8 col-lg-9 position-relative">
                        <input type="text" class="form-control" id="nomInput" value="{{ admin.nom }} " readonly>
                          <button class="btn btn-outline-secondary position-absolute end-0 translate-middle-y" type="button" id="editNomBtn">Edit</button>
                      </div>
                    </div>

                    <div class="row mb-3">
                      <label for="Job" class="col-md-4 col-lg-3 col-form-label">prenom</label>
                      <div class="col-md-8 col-lg-9 position-relative">
                        <input type="text" class="form-control" id="prenomInput" value="{{ admin.prenom }}"readonly>
                          <button class="btn btn-outline-secondary position-absolute end-0 translate-middle-y" type="button" id="editPrenomBtn">Edit</button>
                      </div>
                    </div>

                    <div class="row mb-3">
                      <label for="Country" class="col-md-4 col-lg-3 col-form-label">email</label>
                      <div class="col-md-8 col-lg-9">
                        <input type="email" class="form-control" id="emailInput" value="{{ admin.email }}" readonly>
                      </div>
                    </div>

               
                    <div class="row mb-3">
                      <label for="Phone" class="col-md-4 col-lg-3 col-form-label">Phone</label>
                      <div class="col-md-8 col-lg-9 position-relative">
                        <input type="text" class="form-control" id="phoneInput" value="{{ admin.phone }}" readonly>
                        <button class="btn btn-outline-secondary position-absolute end-0 translate-middle-y" type="button" id="editPhoneBtn">Edit</button>
                      </div>
                    </div>

                    <div class="row mb-3">
                      <div id="errorMessage" class="col-sm-12 text-danger"></div>
                    </div>

                    <div class="text-center">
                      <button type="submit" class="btn btn-primary">Sauvegarder</button>
                    </div>
                  </form><!-- End Profile Edit Form -->

                </div>

                <div class="tab-pane fade pt-3" id="profile-settings">
 <script>
 document.addEventListener("DOMContentLoaded", function() {

      document.getElementById('editUsernameBtn').addEventListener('click', function() {
              toggleEditMode('usernameInput');
          });

          document.getElementById('editNomBtn').addEventListener('click', function() {
              toggleEditMode('nomInput');
          });

          document.getElementById('editPrenomBtn').addEventListener('click', function() {
              toggleEditMode('prenomInput');
          });
          document.getElementById('editPhoneBtn').addEventListener('click', function() {
              toggleEditMode('phoneInput');
          });
          
          function toggleEditMode(inputId) {
          var input = document.getElementById(inputId);
          input.readOnly = !input.readOnly;
          if (input.readOnly) {
            input.classList.remove('edited');
        } else {
            input.classList.add('edited');
        }
      }
      function toggleEditMode(inputId) {
          var inputField = document.getElementById(inputId);
          var editButton = document.getElementById('edit' + inputId.charAt(0).toUpperCase() + inputId.slice(1) + 'Btn');

          if (inputField.readOnly) {
              inputField.readOnly = false;
              editButton.textContent = 'Save';
          } else {
              // save changes or perform other actions here
              inputField.readOnly = true;
              editButton.textContent = 'Edit';
          }
      }
  });
 function updateFormAction() {
        var username = document.getElementById('usernameInput').value;
        var nom = document.getElementById('nomInput').value;
        var prenom = document.getElementById('prenomInput').value;
        var phone = document.getElementById('phoneInput').value;

        var addresses = [];
        var addressInputs = document.querySelectorAll('[id^="adresseInput"]');
        addressInputs.forEach(function(input) {
            addresses.push(input.value);
        });

        var ids = [];
        var idsInputs = document.querySelectorAll('[id^="idInput"]');
        idsInputs.forEach(function(input) {
            ids.push(input.value);
        });

        var adrs = "";
        addresses.forEach(function(address, index) {
            // concatenate each address with its corresponding ID
            adrs += "&adresse&id=" + ids[index] + "=" + address;
        });

        console.log(adrs);
        
        document.getElementById('myForm').action = "{{ path('updateadamin', {'nom': ''}) }}" + nom + "&prenom=" + prenom+"&username=" +username+"&phone=" +phone;
    return true; 
    }    
    
</script>
                  <!-- Settings Form -->
           
                    <form id="myForm2" class="form2" method="POST" action="{{ path('changePassword', {'password': 'default', 'renewPassword': 'default'}) }}" onsubmit="updateFormAction2()">
                    <div class="row mb-3">
                      <label for="newPassword" class="col-md-4 col-lg-3 col-form-label">New Password</label>
                      <div class="col-md-8 col-lg-9">
                        <input  type="password" class="form-control" id="newPassword">
                      </div>
                    </div>

                    <div class="row mb-3">
                      <label for="renewPassword" class="col-md-4 col-lg-3 col-form-label">Re-enter New Password</label>
                      <div class="col-md-8 col-lg-9">
                        <input  type="password" class="form-control" id="renewPassword">
                      </div>
                    </div>
  {% if error == 1 %}
                       
    <div class="alert alert-danger" role="alert">
       <p>les deux champs doivent correspondre.  </p>
    </div>    {% endif %}
                    <div class="text-center">
                      <button type="submit" class="btn btn-primary">Changer mot de passe</button>
                    </div>
                  </form><!-- End Change Password Form -->

                </div>

              </div><!-- End Bordered Tabs -->

            </div>
          </div>

        </div>
      </div>
    </section>
   
<script>
 
      
 function updateFormAction2() {
        var password = document.getElementById('newPassword').value;
        var renewPassword = document.getElementById('renewPassword').value;
        
        
        document.getElementById('myForm2').action = "{{ path('changePassword', {'password': ''}) }}" + password + "&renewPassword=" + renewPassword;
    return true; 
    }    
    
</script>

    
  </main><!-- End #main -->
