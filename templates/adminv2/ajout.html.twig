{% extends 'adminv2.html.twig' %}
 {% block body %}
 {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}  

<body>

 

  <main id="main" class="main">

    <div class="pagetitle">
      <h1>Dashboard</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="index.html">Home</a></li>
          <li class="breadcrumb-item active">ajouter admin</li>
         
        </ol>
      </nav>
    </div><!-- End Page Title -->


        <div class="card">
            <div class="card-body">
              <h5 class="card-title">Ajouter un nouveau administrateur</h5>

            {{ form_start(registrationForm) }} 
           <div id="registrationForm">
           
              <div class="row mb-3">
                <label for="inputText" class="col-sm-2 col-form-label">Username</label>
                <div class="col-sm-10">
                {{ form_row(registrationForm.username, {'attr': {'class': "form-control"}}) }}
                </div>
              </div>

              <div class="row mb-3">
                <label for="inputNumber" class="col-sm-2 col-form-label">Nom</label>
                <div class="col-sm-10">
                  {{ form_row(registrationForm.nom, {'attr': {'class': 'form-control'}}) }}
                </div>
              </div>
              
              <div class="row mb-3">
                <label for="inputDate" class="col-sm-2 col-form-label">Prenom</label>
                <div class="col-sm-10">
                   {{ form_row(registrationForm.prenom, {'attr': {'class': 'form-control'}}) }}
                </div>
              </div>

              <div class="row mb-3">
                <label for="inputTime" class="col-sm-2 col-form-label">Numéro de Téléphone</label>
                <div class="col-sm-10">
                 {{ form_row(registrationForm.phone, {'attr': {'class': 'form-control'}}) }}
                </div>
              </div>
              
              
              <div class="row mb-3">
                <label for="Email" class="col-sm-2 col-form-label">Email</label>
                <div class="col-sm-10">
                  {{ form_row(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                </div>
              </div>

              <div class="row mb-3">
                <label for="inputPassword" class="col-sm-2 col-form-label">Mot de passe</label>
                <div class="col-sm-10">
                  {{ form_row(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                </div>
              </div>
              <div class="row mb-3">
                {% if error == 1  %}
                        <div id="errorMessage" class="col-sm-12 text-danger" role="alert">
                            <p class="pepe">user already exist.</p>
                        </div>
                    {% endif %}
                    {% if error == 2  %}
                        <div id="errorMessage" class="col-sm-12 text-danger" role="alert">
                            <p class="pepe">Le nom doit étre alphabetique.</p>
                        </div>
                    {% endif %}
                    {% if error == 3  %}
                        <div id="errorMessage" class="col-sm-12 text-danger" role="alert">
                            <p class="pepe">Le prenom doit étre alphabetique.</p>
                        </div>
                    {% endif %}
                    {% if error == 4  %}
                        <div id="errorMessage" class="col-sm-12 text-danger" role="alert">
                            <p class="pepe">Le numero de telephone doit étre en forme de 8 chiffres.</p>
                        </div>
                    {% endif %}
                    {# <style>
                        .pepe {
                            padding: 15px;
                            border: 1px solid transparent;
                            border-radius: 4px;
                            margin-bottom: 20px;
                        }

                        .pepe {
                            color: #721c24;
                            background-color: #f8d7da;
                            border-color: #f5c6cb;
                        }
                    </style> #}
              </div>
              
              <div class="row mb-3">
                <div class="col-sm-10">
                  <button type="submit" class="btn btn-primary">Ajout</button>
                </div>
              </div>
          </div>
          {{ form_end(registrationForm) }}  
            </div>
          </div>

        </div>


    <div id="map" style="width:100%; height: 100vh"></div>
    <script src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    
   <script>
    var map = L.map('map').setView([36.806389, 10.181667], 10);
    var initialView = map.getCenter();
    mapLink = "<a href='http://openstreetmap.org'>OpenStreetMap</a>";
    L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', { attribution: 'Leaflet &copy; ' + mapLink + ', contribution', maxZoom: 18 }).addTo(map); 
    var waypoints = [];
    var tours;
    $.ajax({
        type: 'GET',
        url: '{{ path('tourEncours') }}',
        success: function(response) { 
        tours = response;
        },
        error: function(xhr, status, error) {   
        }
    }); 
    forEach(tours){
      $.ajax({
          type: 'GET',
          url: '{{ path('tourDeleveries', {'id':tours.tourId}) }}',
          success: function(response) {
              response.forEach(function(item) {
                  if (item.client) {
                      var clientLatLng = L.latLng(item.client.latitude, item.client.longtitude);
                      waypoints.push(clientLatLng);
                      L.marker(clientLatLng).addTo(map);
                  }
                  if (item.warehouse) {
                      var warehouseLatLng = L.latLng(item.warehouse.latitude, item.warehouse.longtitude);
                      waypoints.push(warehouseLatLng);
                      // Create a warehouse marker with a different color and label
                      L.marker(warehouseLatLng, {
                          icon: L.divIcon({
                              className: 'warehouse-icon',
                              html: '<div>Warehouse</div>',
                          })
                      }).addTo(map);
                  }
              });

              // Create a routing control to generate the route passing through all waypoints
              L.Routing.control({
                  waypoints: waypoints,
                  routeWhileDragging: true,
                  show: false, // Hide the control as we don't need to display it on the map
              }).addTo(map);
          },
          error: function(xhr, status, error) {
              console.error('Error fetching data:', error);
          }
      }); 
    }
</script>

<style>
    .warehouse-icon {
        background-color: #ff5733; /* Change the color as needed */
        border-radius: 50%;
        padding: 5px;
        text-align: center;
        color: black;
    }
</style>
    
  </main><!-- End #main -->

  <!-- ======= Footer ======= -->
  <footer id="footer" class="footer">
    
 
    
    </div>
      
  </footer><!-- End Footer -->


 

  {% endblock %}