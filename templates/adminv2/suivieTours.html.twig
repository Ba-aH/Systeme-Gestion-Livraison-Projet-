{% extends 'adminv2.html.twig' %}
 {% block body %}

<main id="main" class="main">
 <div class="pagetitle">
      <h1>Suivie tours en temps réel</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">Suivie tours</li>
          
        </ol>
      </nav>
    </div><!-- End Page Title -->

   <div class="card">
            <div class="card-body">
              <h5 class="card-title">Tournées en cours : </h5>
 <div id="map" style="width:100%; height: 69vh"></div></div></div>
    <h5 class="card-title">Liste des coursiers actuellement en cours de travail :</h5>
    <table class="table table-hover">
                <thead>
                  <tr>
                    <th scope="col">Username</th>
                    <th scope="col">Nom</th>
                    <th scope="col">Prénom</th>
                    <th scope="col">Numero Telephone</th>
                    <th scope="col">Email</th>
                    <th scope="col">Tourner ID</th>
                  </tr>
                </thead>
                <tbody>
                {% for tours in toursEC %}
                <tr>
                    <td>{{ tours.coursier.username }}</td>
                    <td>{{ tours.coursier.nom }}</td>
                    <td>{{ tours.coursier.prenom}}</td>
                    <td><p><a href="tel:+216  {{ tours.coursier.phone }}" style="color: green;">{{ tours.coursier.phone }}</a></p></td> 
                    <td>{{ tours.coursier.email }}</td>
                    <td>{{ tours.ID }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
  </main>


    <script src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    
   <script>

   





    var map = L.map('map').setView([36.806389, 10.181667], 10);
    var initialView = map.getCenter();
    mapLink = "<a href='http://openstreetmap.org'>OpenStreetMap</a>";
    L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', { attribution: 'Leaflet &copy; ' + mapLink + ', contribution', maxZoom: 18 }).addTo(map); 

    var tours; // Declare the variable 'tours' before the AJAX request

    $.ajax({
        type: 'GET',
        url: '{{ path('tourEncours') }}',
        success: function(response) { 
            tours = response; // assign the response to tours variable
            processTours();
                var toursLength = tours.length;
                console.log("Number of tours:", toursLength);
        },
        error: function(xhr, status, error) {   
            console.error('Error fetching tour data:', error);
        }
    });
    

   let markers = {};
   function processTours() {
    tours.forEach(function(tour) {
        var coursiermarker = L.marker();
        markers[tour.tourId] = coursiermarker;
       
        console.log('Tour ID:', tour.tourId);
        var path = 'https://127.0.0.1:8000/tourDeleveries/' + tour.tourId;
        $.ajax({
            type: 'GET',
            url: path,
            success: function(deliveryResponse) {
                var tourWaypoints = []; // array to store waypoints for the current tour
                deliveryResponse.forEach(function(item) {
                    if (item.client) {
                        var clientLatLng = L.latLng(item.client.latitude, item.client.longtitude);
                        tourWaypoints.push(clientLatLng);
                        L.marker(clientLatLng).addTo(map);
                    }
                    if (item.warehouse) {
                    var warehouseLatLng = L.latLng(item.warehouse.latitude, item.warehouse.longtitude);
                    tourWaypoints.push(warehouseLatLng);

                    var tooltipContent = 'Entrepot de '+item.warehouse.region;
                    var customTooltip = L.tooltip({
                        direction: 'top',
                        permanent: true,
                        opacity: 1
                    }).setContent(tooltipContent);

                    L.marker(warehouseLatLng).bindTooltip(customTooltip).addTo(map);
                }
                      
                });

                L.Routing.control({
                    waypoints: tourWaypoints,
                    routeWhileDragging: false, 
                    draggableWaypoints: false, 
                    show: false, 
                }).addTo(map);
            },
            error: function(xhr, status, error) {   
                console.error('Error fetching delivery data:', error);
            }
        });
    });
}

const url = new URL('http://localhost:3000/hub');
    url.searchParams.append('topic', 'http://monsite.com/user');
    const eventSource = new EventSource(url);
    eventSource.onmessage = e => { 
        const data = JSON.parse(e.data);
        var data2 = {
                positionHistoryLat: data.positionHistoryLat,
                positionHistoryLong: data.positionHistoryLong,
                coursier: data.coursier,
                tourner: data.tourner
            };  


            $.ajax({
                type: 'POST',
                url: '{{ path('addLocationHistory') }}',
                data: data2,
                success: function(response) {
                    console.log('Address added successfully.');
                },
                error: function(xhr, status, error) {
                    console.error('Error adding address:', error);
                }
            });



                var newCoordinates = L.latLng( data.positionHistoryLat, data.positionHistoryLong); 
                markers[data.tourner].setLatLng(newCoordinates);
                if (!map.hasLayer(markers[data.tourner])) {
                    var tooltipContent ='Couriser:'+data.coursier;
                    var customTooltip = L.tooltip({
                        direction: 'top',
                        permanent: true, 
                        opacity: 1 
                    }).setContent(tooltipContent);
                markers[data.tourner].bindTooltip(customTooltip).openTooltip();

                    markers[data.tourner].addTo(map);
                }
                console.log(data);   
    }
  
</script>

<style>
    .warehouse-icon {
        background-color: #ff5733; 
        border-radius: 50%;
        padding: 5px;
        text-align: center;
        color: black;
    }
    .marker-pin {
        width: 35px;
        height: 35px;
        border-radius: 50% 50% 50% 0;
        background: #c30b82;
        position: absolute;
        transform: rotate(-45deg);
    }
   
    .marker-pin::after {
        content: '';
        width: 24px;
        height: 24px;
        margin: 3px 0 0 3px;
        background: #fff;
        position: absolute;
        border-radius: 50%;
    }

    .custom-div-icon i {
    position: absolute;
    font-size: 16px;
    color: black;
    left: 5%;
    transform: translate(-50%, -50%);
    padding: 20px; 
}

</style>
{% endblock %}