{% extends 'adminv2.html.twig' %}
 {% block body %}
<style> .leaflet-div-icon-red {
        background-color: red;
        border-radius: 50%;
        width: 20px; /* Make the marker 20px wide */
        height: 20px;
        margin: -6px -6px 0 0; /* Adjust marker position */
    }
    
      .blue-marker {
        width: 30px;
        height: 50px;
        background-color: blue;
        position: relative;
        border-radius: 50% 50% 0% 50%;
       
    }

    .blue-marker::after {
        content: '';
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: white;
        top: 50%;
        left: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }
    .x7 {
        display: flex; /* Use flexbox */
        align-items: center; /* Align items vertically */
       gap: 20px;
    }
    </style>
<main id="main" class="main">
 <div class="pagetitle">
      <h1>vérifier itinéraire</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">suivie coursiers</li>
          
        </ol>
      </nav>
    </div><!-- End Page Title -->

   <div class="card">
            <div class="card-body">
            {% if tour %}
              <h5 class="card-title">itinéraire de tournée numéro  : {{tour[0].tourner.id}}</h5><div class="x7"> <div class="leaflet-div-icon-red"></div> <p>les adresses des livraisons</p></div>
           {% else %}
           <br>
           <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-lZy0f7f0Oqb9zEyd2JQr2gWCSw5k31siEXkxssjz9FJa2M2ca7ByP0xIeMIvHbVC" crossorigin="anonymous">

<!-- Your HTML code with Bootstrap alert -->
<div class="alert alert-danger bg-danger text-light border-0 alert-dismissible fade show" role="alert">
   <p>pas de données disponibles pour cette tounée</p>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<!-- Bootstrap JavaScript (optional, if you want to use the alert dismiss functionality) -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js" integrity="sha384-OgVRvuATP1z7JjHLku5vH9st7Yzy/uqynu5lYh84BUi2JgIJx3hx94W1t+V4fFeM" crossorigin="anonymous"></script>
    
{% endif %}
 <div id="map" style="width:100%; height: 69vh"></div>
 </div>
 
 
 
 
 
 <table class="table table-hover">
                <thead>
                  <tr>
                  
                    <th scope="col">Id</th>
                    <th scope="col">Référence</th>
                  
                    <th scope="col">Date de livraison</th>
                      <th scope="col">Client ID</th>
                  <th scope="col">Téléphone</th> 
                     <th scope="col">Email</th> 
                  </tr>
                </thead>
                <tbody>
                  {% for liv in livs %}
                  <tr>
                         <td>{{ liv.id }}</td>
                                <td>{{ liv.reference }}</td>
                                <td>{{ liv.livraisonDate|date('Y-m-d ') }}</td>
                                <td>{{liv.client.id}}</td>
                                 <td>{{liv.client.phone}}</td>
                                  <td>{{liv.client.email}}</td>
                   
                    <td></td>
                  </tr>
                 
                      {% endfor %}
                </tbody>
              </table>
 
 
 
 
 
 
 
 
 
 </div>
  </main>


    <script src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    
   <script>
    var map = L.map('map').setView([36.806389, 10.181667], 10);
    var initialView = map.getCenter();
    mapLink = "<a href='http://openstreetmap.org'>OpenStreetMap</a>";
    L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', { attribution: 'Leaflet &copy; ' + mapLink + ', contribution', maxZoom: 18 }).addTo(map); 

   
  var tourWaypoints = [ {% for to in tour %}
                            L.latLng({{ to.getPositionHistoryLat()}}, {{ to.getPositionHistoryLong()  }}),
                         {% endfor %}
                        ]; // Define the tour waypoints
                        var firstWaypoint = tourWaypoints[0];
var lastWaypoint = tourWaypoints[tourWaypoints.length - 1];

// Create markers for first and last points
var firstMarker = L.marker(firstWaypoint);
var lastMarker = L.marker(lastWaypoint);
firstMarker.addTo(map);
lastMarker.addTo(map);
console.log(tourWaypoints); 
    L.Routing.control({
        waypoints: tourWaypoints,
        routeWhileDragging: false, // Disable route dragging
        draggableWaypoints: false, // Disable waypoint dragging
        show: false, // Hide the control as we don't need to display it on the map
     createMarker: function() { return null; }
    }).addTo(map);


{% for ad in adresses %}
        var lat = {{ ad.latitude }};
        var lng = {{ ad.longitude }};
      var livId = "{{ livs[loop.index0].id }}";
      // console.log("livId: " + livId);

        // Create marker
       var redIcon = L.divIcon({
            className: 'leaflet-div-icon-red'
        });

        

        var marker = L.marker([lat, lng], {icon: redIcon}).addTo(map);






var tooltipContent = `<b>livraison id :</b> ${livId}`;

    // Create a custom tooltip
    var customTooltip = L.tooltip({
        direction: 'top', // Position the tooltip above the marker
        permanent: true, // Make the tooltip permanent (always visible)
        opacity: 1 // Set the opacity to 1 to make it fully visible
    }).setContent(tooltipContent);

    // Bind the custom tooltip to the marker
    marker.bindTooltip(customTooltip).openTooltip();




{% endfor %}


</script>



<style>
    .warehouse-icon {
        background-color: #ff5733; /* Change the color as needed */
        border-radius: 50%;
        padding: 5px;
        text-align: center;
        color: black;
    }
    .marker-pin {
    width: 30px;
    height: 30px;
    border-radius: 50% 50% 50% 0;
    background: #c30b82;
    position: absolute;
    transform: rotate(-45deg);
    left: 50%;
    top: 50%;
    margin: -15px 0 0 -15px;
  }
  // to draw white circle
  .marker-pin::after {
      content: '';
      width: 24px;
      height: 24px;
      margin: 3px 0 0 3px;
      background: #fff;
      position: absolute;
      border-radius: 50%;
  }

  // to align icon
  .custom-div-icon i {
    position: absolute;
    width: 22px;
    font-size: 22px;
    left: 0;
    right: 0;
    margin: 10px auto;
    text-align: center;
  }
</style>
{% endblock %}