{% extends 'admin.html.twig' %}

{% block body %}
<head>
<meta charset="utf-8">
<title>Profile</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.1/dist/css/bootstrap.min.css" rel="stylesheet">
<style type="text/css">
    body {
        margin-top:20px;
    }
    .form-group {
        margin-bottom: 15px;
    }
    .form-group label {
        margin-bottom: 5px;
    }
    .align-self-end {
        align-self: flex-end;
    }
    .text-right {
        text-align: right;
    }
    .invisible {
        visibility: hidden;
    }
</style>
</head>
<body>
<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet">
<section id="topbar" class="d-flex align-items-center"></section>
<header id="header" class="d-flex align-items-center">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="logo">
            <h1><a href="index.html">Colis Express</a></h1>
        </div>
        <nav id="navbar" class="navbar">
            <ul>
                <li><a href="{{ path('afficher_tourneesAU') }}">Home</a></li>
                <li><a href="{{ path('afaire') }}">travail a faire</a></li>
                <li><a href="{{ path('afficher_tourneesrecent') }}">historique</a></li>
                <li><a href="{{ path('disponibilté') }}">disponibilité</a></li>
                <li><a href="{{ path('salarie') }}">paiement</a></li>
                <li><a class="active" href="{{ path('coursierProfile') }}">gérer compte</a></li>
                <li><a href="{{ path('app_logout') }}">logout</a></li>
            </ul>
        </nav>
    </div>
</header>
<section id="breadcrumbs" class="breadcrumbs">
    <div class="container">
        <ol>
            <li><a href="{{ path('coursierProfile') }}">gérer compte</a></li>
            <li>profil</li>
        </ol>
        <h2>gérer mon profil</h2>
    </div>
</section>
<div class="container">
    <div class="row flex-lg-nowrap">
        <div class="col-12 col-lg-auto mb-3" style="width: 200px;"></div>
        <div class="col">
            <div class="row">
                <div class="col mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="e-profile">
                                <div class="row">
                                    <div class="col-12 col-sm-auto mb-3">
                                        <div class="mx-auto" style="width: 140px;">
                                            <div class="d-flex justify-content-center align-items-center rounded" style="height: 140px; background-color: rgb(233, 236, 239);">
                                            <img src="{{ asset('images/user5.jpg') }}" alt="Admin" width="140">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col d-flex flex-column flex-sm-row justify-content-between mb-3">
                                        <div class="text-center text-sm-left mb-2 mb-sm-0">
                                            <h4 class="pt-sm-2 pb-1 mb-0 text-nowrap">{{ user.nom }} {{ user.prenom }}</h4>
                                            <p class="mb-0">@{{ user.username }}</p>
                                            <div class="text-muted"><small>Last seen 2 hours ago</small></div>
                                        </div>
                                        <div class="text-center text-sm-right">
                                            <span class="badge badge-secondary">Coursier</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-content pt-3">
                                    <div class="tab-pane active">
                                        <form id="myForm" class="form" method="POST" action="{{ path('update_coursier_profile') }}" onsubmit="controle(event)">
                                            <div class="row">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Username</label>
                                                                <div class="input-group">
                                                                    <input id="usernameInput" name="username" class="form-control" type="text" value="{{ user.username }}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editUsernameBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div> 
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Telephone</label>
                                                                <div class="input-group">
                                                                    <input id="phoneInput" class="form-control" name="phone" type="text" value="{{ user.phone }}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editPhoneBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>  
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Nom</label>
                                                                <div class="input-group">
                                                                    <input id="nomInput" class="form-control" type="text" name="nom" value="{{ user.nom }}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editNomBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Prenom</label>
                                                                <div class="input-group">
                                                                    <input id="prenomInput" name="prenom" class="form-control" type="text" value="{{ user.prenom }}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editPrenomBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Email</label>
                                                                <div class="input-group">
                                                                    <input id="emailInput" class="form-control" type="text" value="{{ user.email }}" readonly>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Moyen De Transport</label>
                                                                <div class="input-group">
                                                                    <select id="transportationMeanSelect" name="transportationMean" class="form-control" disabled>
                                                                        {% for transportMean in transportMeans %}
                                                                            <option value="{{ transportMean.id }}" {% if transportMean.id == user.transportMean.id %}selected{% endif %}>
                                                                                {{ transportMean.type }}
                                                                            </option>
                                                                        {% endfor %}
                                                                    </select>
                                                                    {# <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editTransportationMeanBtn">Edit</button>
                                                                    </div> #}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="errorMessages" class="text-danger"></div>
                                            <div class="row">
                                                <div class="col d-flex justify-content-end">
                                                    <button class="btn btn-primary" type="submit">Sauvegarder les modifications</button>
                                                </div>
                                            </div> 
                                        </form>
                                        <form id="myForm2" class="form2" method="POST" action="{{ path('changePassword_coursier') }}" onsubmit="updateFormAction2(event)">
                                            <div class="mb-2"><b>Changer mot de passe</b></div>
                                            <div class="row">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label for="new-password">Nouveau mot de passe</label>
                                                                <input name="password" id="new-password" class="form-control" type="password" placeholder="•••••••••">
                                                            </div>
                                                        </div>
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label for="confirm-password">Confirmez le mot de passe<span class="d-none d-xl-inline"></span></label>
                                                                <input name="renewPassword" id="confirm-password" class="form-control" type="password" placeholder="•••••••••">
                                                            </div>
                                                        </div>
                                                        <div class="align-self-end"> 
                                                            <div class="form-group text-right">
                                                                <button class="btn btn-primary" type="submit">Changement</button>
                                                            </div>
                                                        </div>
                                                        <div class="invisible" id="message2"> mot de passe changé </div>
                                                    </div>
                                                </div>
                                            </div> 
                                        </form>      
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const editButtons = {
        username: document.getElementById("editUsernameBtn"),
        phone: document.getElementById("editPhoneBtn"),
        nom: document.getElementById("editNomBtn"),
        prenom: document.getElementById("editPrenomBtn"),
        transportationMean: document.getElementById("editTransportationMeanBtn")
    };
    
    const inputFields = {
        username: document.getElementById("usernameInput"),
        phone: document.getElementById("phoneInput"),
        nom: document.getElementById("nomInput"),
        prenom: document.getElementById("prenomInput"),
        transportationMean: document.getElementById("transportationMeanSelect")
    };

    editButtons.username.addEventListener("click", function() {
        inputFields.username.removeAttribute("readonly");
    });

    editButtons.phone.addEventListener("click", function() {
        inputFields.phone.removeAttribute("readonly");
    });

    editButtons.nom.addEventListener("click", function() {
        inputFields.nom.removeAttribute("readonly");
    });

    editButtons.prenom.addEventListener("click", function() {
        inputFields.prenom.removeAttribute("readonly");
    });

    editButtons.transportationMean.addEventListener("click", function() {
        inputFields.transportationMean.removeAttribute("disabled");
    });
});

function controle(event) {
    const phoneInput = document.getElementById('phoneInput').value.trim();
    const errorMessages = document.getElementById('errorMessages');
    errorMessages.innerHTML = "";

    if (phoneInput.length !== 8) {
        errorMessages.innerHTML += "Numéro de téléphone invalide. ";
        event.preventDefault();
    }

    const phonePattern = /^[0-9]{8}$/;
    if (!phonePattern.test(phoneInput)) {
        errorMessages.innerHTML += "Numéro de téléphone doit être composé de 8 chiffres. ";
        event.preventDefault();
    }
}

function updateFormAction2(event) {
    const newPassword = document.getElementById('new-password').value;
    const confirmPassword = document.getElementById('confirm-password').value;

    if (newPassword !== confirmPassword) {
        alert('Les mots de passe ne correspondent pas');
        event.preventDefault();
    } else {
        alert('Mot de passe changé avec succès');
    }
}
</script>

</body>
{% endblock %}
