<script>
   document.addEventListener("DOMContentLoaded", function() {
    // JavaScript code to toggle edit mode
    document.getElementById('editUsernameBtn').addEventListener('click', function() {
        toggleEditMode('usernameInput');
    });

    document.getElementById('editNomBtn').addEventListener('click', function() {
        toggleEditMode('nomInput');
    });

    document.getElementById('editPrenomBtn').addEventListener('click', function() {
        toggleEditMode('prenomInput');
    });

    document.getElementById('editPhoneBtn').addEventListener('click', function() {
        toggleEditMode('phoneInput');
    });

    // Function to toggle edit mode for a specific input field
    function toggleEditMode(inputId) {
        var inputField = document.getElementById(inputId);
        var editButton = document.getElementById('edit' + inputId.charAt(0).toUpperCase() + inputId.slice(1) + 'Btn');

        if (inputField.readOnly) {
            inputField.readOnly = false;
            editButton.textContent = 'Save';
        } else {
            // Save changes or perform other actions here
            inputField.readOnly = true;
            editButton.textContent = 'Edit';
        }
    }
});
   

   function controle() {
        var nomInput = document.getElementById('nomInput').value.trim();
        var prenomInput = document.getElementById('prenomInput').value.trim();
        var phoneInput = document.getElementById('phoneInput').value.trim();
        var nomRegex = /^[A-Za-zÀ-ÖØ-öø-ÿ\s-]+$/;
        var phoneRegex = /^[0-9]{8}$/;
        var isValid = true;
        var errorMessages = document.getElementById('errorMessages');
        errorMessages.innerHTML = ''; // Clear previous error messages

        // Validation for nom field
        if (!nomRegex.test(nomInput)) {
            errorMessages.innerHTML += "Nom doit être uniquement du texte.<br>";
            isValid = false;
        }

        // Validation for prenom field
        if (!nomRegex.test(prenomInput)) {
            errorMessages.innerHTML += "Prenom doit être uniquement du texte.<br>";
            isValid = false;
        }

        // Validation for phone field
        if (!phoneRegex.test(phoneInput)) {
            errorMessages.innerHTML += "Telephone doit contenir 8 chiffres.<br>";
            isValid = false;
        }

        if (!isValid) {
            event.preventDefault(); // Prevent form submission if validation fails
        }
        return isValid;
    }




</script>
