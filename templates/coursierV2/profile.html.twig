                                            <h4 class="pt-sm-2 pb-1 mb-0 text-nowrap">{{user.nom}} {{user.prenom}}</h4>
                                            <p class="mb-0">@{{user.username}}</p>
                                            <div class="text-muted"><small>Last seen 2 hours ago</small></div>
                                            <div class="mt-2">
                                                <button class="btn btn-primary" type="button">
                                                    <i class="fa fa-fw fa-camera"></i>
                                                    <span>Change Photo</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="text-center text-sm-right">
                                            <span class="badge badge-secondary">Coursier</span>
                                            <div class="text-muted"><small>Joined {{dateAjout}}</small></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-content pt-3">
                                    <div class="tab-pane active">
                                        <form id="myForm" class="form" method="POST" action="{{ path('update_coursier_profile', {'nom': 'default', 'prenom': 'default', 'username':'default', 'phone':'default'}) }}" onsubmit="updateFormAction()">
                                            <div class="row">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Username</label>
                                                                <div class="input-group">
                                                                    <input id="usernameInput" class="form-control" type="text" value="{{ user.username }}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editUsernameBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div> 
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Telephone</label>
                                                                <div class="input-group">
                                                                    <input id="phoneInput" class="form-control" type="text"  value="{{user.phone}}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editPhoneBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>  
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Nom</label>
                                                                <div class="input-group">
                                                                    <input id="nomInput" class="form-control" type="text" name="nomInput"  value="{{user.nom}}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editNomBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Prenom</label>
                                                                <div class="input-group">
                                                                    <input id="prenomInput" class="form-control" type="text"   value="{{user.prenom}}" readonly>
                                                                    <div class="input-group-append">
                                                                        <button class="btn btn-outline-secondary" type="button" id="editPrenomBtn">Edit</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label>Email</label>
                                                                <div class="input-group">
                                                                    <input id="emailInput" class="form-control" type="text"  value="{{user.email}}" readonly>
                                    
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-2"><b>Change Password</b></div>
                                            <div class="row">
                                                <div class="col">
                                                    <div class="row">
                                                    
