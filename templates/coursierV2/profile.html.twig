    function updateFormAction2(event) {
        var newPassword = document.getElementById('new-password').value;
        var confirmPassword = document.getElementById('confirm-password').value;
        var errorMessage = document.getElementById('error-message');
        var isValid = true;

        if (newPassword.length < 6) {
            errorMessage.textContent = "Le mot de passe doit avoir au moins 6 caractères.";
            errorMessage.classList.remove('d-none');
            isValid = false;
        } else if (!(/[a-z]/.test(newPassword) && /[A-Z]/.test(newPassword) && /[0-9]/.test(newPassword))) {
            errorMessage.textContent = "Le mot de passe doit contenir des lettres minuscules, des lettres majuscules et des chiffres.";
            errorMessage.classList.remove('d-none');
            isValid = false;
        } 

        if (!isValid) {
            event.preventDefault(); // Prevent form submission if validation fails
        }

        return isValid;
    }
