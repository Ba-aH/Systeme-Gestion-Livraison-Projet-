<style>
  /* Styles for the custom dialog */
  .dialog-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .dialog-box {
    background-color: #fff;
    border-radius: 5px;
    padding: 20px;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  }

  .dialog-buttons {
    margin-top: 20px;
  }

  /* Styling for buttons */
  #confirmButton {
    background-color: green;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  #confirmButton:hover {
    background-color: darkgreen;
  }

  #cancelButton {
    background-color: red;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  #cancelButton:hover {
    background-color: darkred;
  }
</style>
