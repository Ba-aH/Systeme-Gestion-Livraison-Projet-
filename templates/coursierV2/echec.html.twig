                background-color: #fff;
                border-radius: 5px;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
                cursor: pointer; /* Add cursor pointer to indicate selectable */
            }

            .list-itemp.selected {
                background-color: #007bff; /* Change background color of selected item */
                color: #fff; /* Change text color of selected item */
            }

            /* Input styles */
            .input-containerp {
                margin-top: 20px;
                position: relative;
            }

            .input-containerp input[type="text"] {
                width: calc(100% - 40px);
                padding: 10px;
                border: none;
                border-radius: 5px;
                background-color: #fff;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
                outline: none;
            }

            .input-containerp button {
                position: absolute;
                top: 0;
                right: 0;
                padding: 10px;
                border: none;
                border-radius: 0 5px 5px 0;
                background-color: #007bff;
                color: #fff;
                cursor: pointer;
                transition: background-color 0.3s ease;
            }

            .input-containerp button:hover {
                background-color: #0056b3;
            }

            /* Submit button styles */
