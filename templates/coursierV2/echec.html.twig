        </head>
        <body>

        <div class="containerp">
            <h2>choisir un raison pour confirmer l'echec de cette livraison</h2>

            <!-- List -->
            <ul class="listp">
                 {% for li in list %}
                        <li class="list-itemp" data-id="{{ li.id }}"> 
                            
                           {{ li.id }} -  {{ li.raison }}
                             
                              </li>
                        {% endfor %}
             
                <!-- Add more list items as needed -->
            </ul>

            <!-- Input -->
            <form method="post" action="{{ path('echecsubmit') }}" >
            <label for="newItem">donner votre propre raison:</label><br /><br />
            <input type="text" name="newItem" placeholder="Add new reason..."style="width: 560px; height: 40px;"><br />
            <input type="hidden" name="selectedres" id="selectedres">
            <input type="hidden" name="selectedItem" id="selectedItem">
            <input type="hidden" name="livraisonId" id="livraisonId" value="{{ livraisonId }}"><br />

               <button type="submit" class="submit-button" id="submitItemButton">confirmer</button>
                <!-- Hidden input field to store selected item -->
            </form>

            <!-- Submit Selected Item button -->
     
        </div>

        <script>
       

            // Function to handle submission of selected item
           var listItems = document.querySelectorAll(".list-itemp");
    listItems.forEach(function (item) {
        item.addEventListener("click", function () {
            // Deselect all list items
            listItems.forEach(function (item) {
                item.classList.remove("selected");
            });
            // Select the clicked item
            this.classList.add("selected");

            // Update the value of the hidden input field with the selected item
            // var selectedItemValue = this.textContent.trim();
               var selectedItemText = this.textContent.trim();
            var selectedItemId = selectedItemText.split(' - ')[0];
               var selectedItemres = selectedItemText.split(' - ')[1]; // Assuming ID comes before '-'
            document.getElementById("selectedItem").value = selectedItemId;
                  document.getElementById("selectedres").value = selectedItemres;
        });
    });

         
        </script>


