    }

    .button {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

    .confirm-normal {
        background-color: #4caf50;
        color: #fff;
    }

    .confirm-with-pin {
        background-color: #007bff;
        color: #fff;
    }

    input[type="text"] {
        width: 200px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 16px;
        margin: 0 auto; /* Center input horizontally */
        display: block; /* Display input as block element */
    }

    .divider {
        border-right: 1px solid #ccc; /* Vertical line between buttons and input */
        height: 60px; /* Adjust height as needed */
        margin: 0 20px; /* Added margin around divider */
    }
    .button-container{
       display:flex;
       justify-content: center;
       align-items: center;
