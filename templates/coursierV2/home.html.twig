<script>
  // Function to show the confirmation dialog for a specific link
  function showConfirmationDialog(linkId) {
    var confirmationDialog = document.getElementById('confirmationDialog');
    var link = document.getElementById(linkId);

    // Show the confirmation dialog
    confirmationDialog.style.display = 'flex';

    // Store the link's href in a data attribute for later use
    confirmationDialog.setAttribute('data-href', link.href);
  }

  // Function to handle confirmation for a specific link
  function confirmAction() {
    var confirmationDialog = document.getElementById('confirmationDialog');

    // Get the stored href from the data attribute
    var href = confirmationDialog.getAttribute('data-href');

    // Navigate to the link's href if confirmed
    if (href) {
      window.location.href = href;
    }
  }

  // Attach event listeners to each annuler button
  {% for livraison in livraisons %}
    document.getElementById('link{{ loop.index }}').addEventListener('click', function(event) {
      event.preventDefault(); // Prevent the default link behavior
      showConfirmationDialog('link{{ loop.index }}');
    });
  {% endfor %}

  // Attach event listener to the confirm button
  document.getElementById('confirmButton').addEventListener('click', function(event) {
    event.preventDefault(); // Prevent the default button behavior
    confirmAction();
  });

  // Function to cancel the action
  function cancelAction() {
    var confirmationDialog = document.getElementById('confirmationDialog');
    // Hide the confirmation dialog
    confirmationDialog.style.display = 'none';
  }
</script>
 <script>
      fetch('{{ path('notificationc') }}')
      .then(response => response.json())
      .then(data => {
          const notificationCountElement = document.getElementById('notification-count');
          if (notificationCountElement) {
              notificationCountElement.textContent = data.nb;
          }
          const notificationList = document.getElementById('notification-list');
          data.tournées.forEach(tournée => {
              const referenceItem = document.createElement('div');
              var date = new Date(tournée.date);
           var formattedDate = date.toLocaleDateString();
              referenceItem.innerHTML = `
                  <i class="bi bi-exclamation-circle text-warning"></i>
                  <div>
                       <h5>Tournée numéro:  ${tournée.id}</h5>
                       
                      <h5>Doit étre fait en:  ${formattedDate} </h5>
                       <div class="cube">
                       
  <p>statut:  ${tournée.statutTourner}</p>
</div></br></br>
                  </div>
              `;
              notificationList.appendChild(referenceItem);
          });
      })
      .catch(error => {
          console.error('Error fetching data:', error);
      });
      
      </script>

