   function calculateDistance(lat1, lon1, lat2, lon2) {
  // Convert degrees to radians
  const earthRadius = 6371e3; // meters (change units if desired)
  const radiansLat1 = deg2rad(lat1);
  const radiansLat2 = deg2rad(lat2);
  const dLat = radiansLat2 - radiansLat1;
  const dLon = deg2rad(lon2 - lon1);

  const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(radiansLat1) * Math.cos(radiansLat2) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);

  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

  return earthRadius * c;
}

function deg2rad(deg) {
  return deg * (Math.PI / 180);
}


    function calculateAndSortDistances(latLongDist) {
        // Calculate distances for each item in latLongDist
        latLongDist.forEach(function(item) {
            item.distance = calculateDistance(item.latitude, item.longitude, {{warehouse.latitude}}, {{warehouse.longitude}});
        });

        // Sort latLongDist based on distances (ascending order)
        latLongDist.sort(function(a, b) {
            return a.distance - b.distance;
        });
 

var latLongDistItem = {
        latitude: {{warehouse.latitude}},
        longitude:  {{warehouse.longitude}},
        ref: ' {{warehouse.nom}} warehouse',
        
    };

    // Add new item to the beginning of the array
    latLongDist.unshift(latLongDistItem);

        // Use the sorted latLongDist for further processing
        console.log("Sorted latLongDist:", latLongDist);

            var map = L.map('map').setView([{{warehouse.latitude}}, {{warehouse.longitude}}], 10);
             mapLink = "<a href='http://openstreetmap.org'>OpenStreetMap</a>";
        L.tileLayer('http://{s}.tile.osm.org/{z}/{x}/{y}.png', {
            attribution: 'Leaflet &copy; ' + mapLink + ', contribution',
            maxZoom: 18
        }).addTo(map);
    // Add tile layer
  
    // Create an array of coordinates for the route
    var routeCoordinates = [];
    latLongDist.forEach(function(item) {
        routeCoordinates.push([item.latitude, item.longitude]);
         
          
    });
 
var routingControl; 
    // Create Leaflet Routing Machine control
   routingControl= L.Routing.control({
        waypoints: routeCoordinates,
        routeWhileDragging: true
    }).addTo(map);



for (var i = 0; i < latLongDist.length; i++) {
    // Create marker for each latitude and longitude
    var marker = L.marker([latLongDist[i].latitude, latLongDist[i].longitude]).addTo(map);

    // Create custom tooltip content
    var tooltipContent = `<b>Reference:</b> ${latLongDist[i].ref}`;

    // Create a custom tooltip
    var customTooltip = L.tooltip({
        direction: 'top', // Position the tooltip above the marker
        permanent: true, // Make the tooltip permanent (always visible)
        opacity: 1 // Set the opacity to 1 to make it fully visible
    }).setContent(tooltipContent);

    // Bind the custom tooltip to the marker
    marker.bindTooltip(customTooltip).openTooltip();
}




 routingControl.on('routesfound', function(e) {

  var totalDistance = e.routes[0].summary.totalDistance;

  console.log("Total distance:", totalDistance);

});
 }
 calculateAndSortDistances(latLongDistJSON);

   
   
   </script>             
