{% extends 'base.html.twig' %}
{% block body %}
<link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css?family=Karla:400,700&display=swap');

        .font-family-karla {
            font-family: karla;
        }
        .error-message {
            color: #ff0000; /* Set your desired color for the error message */
            font-size: 14px; /* Set your desired font size */
            margin-top: 8px; /* Add some spacing above the error message */
        }
    </style>

    <body class="bg-white font-family-karla h-screen">

        <div class="w-full flex flex-wrap">

            <!-- Login Section -->
            <div class="w-full md:w-1/2 flex flex-col">

                
            <div class="flex flex-col justify-center md:justify-start my-auto pt-8 md:pt-0 px-8 md:px-24 lg:px-32">
              
    <form id="myForm" method="post" onsubmit="return updateFormAction()">
        <label for="pin" class="text-lg">PIN:</label>
        <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mt-1 leading-tight focus:outline-none focus:shadow-outline" type="text" id="pin" name="pin" placeholder="Enter PIN" required>
        <br>
        <button type="submit" class="bg-blue-500 text-white font-bold text-lg hover:bg-blue-700 p-2 mt-8 rounded-md">Confirmer</button>
    </form>

    </div>
        </div>
        <div class="w-1/1 ">
            <img class="object-cover w-full h-screen hidden md:block" src="{{ asset('images/livreur.jpg') }}" alt="Background" />
        </div>
    </div>

    <script>
        function updateFormAction() {
            var selectedPIN = document.getElementById('pin').value;
            document.getElementById('myForm').action = "{{ path('verifCodePin') }}" + "?pin=" + encodeURIComponent(selectedPIN);
            return true;
        }
    </script>

{% endblock %}