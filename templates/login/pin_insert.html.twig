{% extends 'base.html.twig' %}
{% block body %}

    <form id="myForm" method="post" onsubmit="return updateFormAction()">
        <label for="pin">PIN:</label>
        <input type="text" id="pin" name="pin" placeholder="Enter PIN" required>
        <br>
        <button type="submit">Confirmer</button>
    </form>

    <script>
        function updateFormAction() {
            var selectedPIN = document.getElementById('pin').value;
            document.getElementById('myForm').action = "{{ path('verifCodePin') }}" + "?pin=" + encodeURIComponent(selectedPIN);
            return true;
        }
    </script>

{% endblock %}