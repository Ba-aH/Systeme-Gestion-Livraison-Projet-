{# templates/login/index.html.twig #}
{% extends 'base.html.twig' %}

{# ... #}

{% block body %}
    

    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css?family=Karla:400,700&display=swap');

        .font-family-karla {
            font-family: karla;
        }
        .error-message {
            color: #ff0000; /* Set your desired color for the error message */
            font-size: 14px; /* Set your desired font size */
            margin-top: 8px; /* Add some spacing above the error message */
        }
    </style>
    </style>

    <body class="bg-white font-family-karla h-screen">

        <div class="w-full flex flex-wrap">

            <!-- Login Section -->
            <div class="w-full md:w-1/2 flex flex-col">

                
            <div class="flex flex-col justify-center md:justify-start my-auto pt-8 md:pt-0 px-8 md:px-24 lg:px-32">
                <p class="text-center text-3xl">Welcome.</p>

        <form action="{{ path('app_login') }}" method="post">
            <label for="username" class="text-lg">Email:</label>
            <input type="text" id="username"placeholder="your@email.com" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mt-1 leading-tight focus:outline-none focus:shadow-outline"  name="_username" value="{{ last_username }}">

            <label for="password" class="text-lg">Password:</label>
            <input type="password" id="password" name="_password" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mt-1 leading-tight focus:outline-none focus:shadow-outline">
           
            <a href="" class="text-blue-500 hover:text-blue-700 text-sm">Forgot Password</a><br>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            {% if error %}
                <div class="error-message text-red-500">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <button type="submit" class="bg-blue-500 text-white font-bold text-lg hover:bg-blue-700 p-2 mt-8 rounded-md">login</button>
        </form>

        <div class="text-center pt-12 pb-12">
                    <p>Don't have an account? <a href="{{path('select_register')}}" class="underline font-semibold">Register here.</a></p>
                </div>
            </div>

        </div>

        <!-- Image Section -->
        <div class="w-1/1 ">
            <img class="object-cover w-full h-screen hidden md:block" src="{{ asset('images/livreur.jpg') }}" alt="Background" />
        </div>
    </div>

    <script>
        function submitForm() {
            var formData = {
                username: document.getElementById('username').value,
                password: document.getElementById('password').value,
            };

            fetch('/api/login_check', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData),
            })
            .then(response => response.json())
            .then(data => {
                // Handle the token response
                console.log('Token:', data.token);
                localStorage.setItem('token', data.token);

                // Redirect to another page if needed

                // Send the token to the server
                fetch('/api/login', {
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + data.token,
                    },
                })
                .then(response => response.json())
                .then(data => {
                    // Handle the response from the server
                    console.log('Server Response:', data);
                })
                .catch((error) => {
                    console.error('Error:', error);
                });
            })
            .catch((error) => {
                console.error('Error:', error);
            });

            // Function to get user data can be outside the submitForm function
            function getUserData() {
                var token = localStorage.getItem('token');

                if (token) {
                    var userData = JSON.parse(atob(token.split('.')[1]));

                    console.log('User Data:', userData);

                    // Use the user data as needed
                } else {
                    console.error('Token not found.');
                }
            }
            getUserData();
        }
    </script>

    
{% endblock %}