

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}   
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">


    
 <div class="w-full flex flex-wrap">

        <div class="form-group">
            <div class="flex flex-col justify-center md:justify-start my-auto pt-8 md:pt-0 px-8 md:px-24 lg:px-32">
               
       
                {{ form_start(ResetPasswordForm, {'attr': {'action': path('change-password',{'pin': pin}) }}) }}                   
                    <div class="flex flex-col pt-4">
                            <label for="password" class="form-label">Nouveau mot de passe</label>
                            {{ form_row(ResetPasswordForm.password, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    
                    <div class="flex flex-col pt-4">
                            <label for="confirmPassword" class="form-label">Confirmez le mot de passe</label>
                            {{ form_row(ResetPasswordForm.confirmPassword, {'attr': {'class': 'form-input'}}) }}
                    </div>

                        {% if error is defined and error %}
                            <div class="flex flex-col pt-4">
                                <p style="color: red;">{{ error }}</p>
                            </div>
                        {% endif %}
                    <button type="submit" class="bg-blue-500 text-white font-bold text-lg hover:bg-blue-700 p-2 mt-8 rounded-md">Réinitialiser</button>

                {{ form_end(ResetPasswordForm) }}  
                
            </div>

        </div>

       
        <div class="w-1/1 ">
            <img class="object-cover w-full h-screen hidden md:block" src="{{ asset('images/courier-box-workman-fragile-man.jpg') }}" alt="Background" />
        </div>
    </div>

    

    <style>
        .agree-label {
            font-size: 1rem;
            margin-bottom: 0.5rem;
            margin-right: 0.5rem; /* Adjust the value as needed for spacing */
        }
        
        .form-group {
            margin-bottom: 1.5rem;
            margin-top: 4%;
        }

        /* Style for form labels */
        .form-label {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            font-weight: bold;
        }

        /* Style for form inputs */
        .form-input {
            width: 100%;
            padding: 0.75rem;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 0.25rem;
        }

        /* Style for the Register button */
        .register-button {
            background-color: #3490dc;
            color: #ffffff;
            font-weight: bold;
            font-size: 1.25rem;
            padding: 0.75rem 1.5rem;
            border-radius: 0.25rem;
            cursor: pointer;
        }

        .register-button:hover {
            background-color: #2779bd;
        }

        /* Style for the "Already have an account" link */
        .login-link {
            text-decoration: underline;
            font-weight: bold;
            color: #3490dc;
        }

        .login-link:hover {
            color: #2779bd;
        }

    </style>
    <style>
        @import url('https://fonts.googleapis.com/css?family=Karla:400,700&display=swap');

        .font-family-karla {
            font-family: karla;
        }

        
    </style>

{% endblock %}