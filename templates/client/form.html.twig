  .containert {
    width: 80%;
    margin: 50px auto;
  
  
    padding: 20px;
  }

  .section {
  width: 80%;
    margin: 50px auto;
    background-color: #f9f9f9;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(100px, auto);
    gap: 20px;
       margin-bottom: 60px; 
  }
  .infot {
    width: 100%;
  }

  label {
    font-weight: bold;
  }
    .infot:hover {
    background-color: #f0f0f0;
    transition: background-color 0.3s ease;
  }
    h2 {
    margin-bottom: 60px; /* Add more space between h2 and sections */
  }
.section.bt  {
   
  display: flex;
  justify-content: center;
  align-items: center;

}

.form {
  width: 300px;
  padding: 20px;
  border: 1px solid #ccc;
  border-radius: 5px;
  background-color: #f9f9f9;
}

label {
  font-weight: bold;
}

input[type="date"],
select {
  width: calc(100% - 12px);
  padding: 6px;
  margin-bottom: 10px;
  border: 1px solid #ccc;
  border-radius: 3px;
}

input[type="submit"] {
  width: 100%;
  padding: 10px;
  background-color: #007bff;
  color: #fff;
  border: none;
  border-radius: 3px;
  cursor: pointer;
}

input[type="submit"]:hover {
  background-color: #0056b3;
}
.alert{
 display: flex;
  justify-content: center;
  align-items: center;
    width: 1200px;
}
