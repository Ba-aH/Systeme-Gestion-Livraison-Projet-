<script>
  window.onload = function() {
    // Sélectionner le formulaire
    var form = document.querySelector('.php-email-form');

    // Ajouter un écouteur d'événement pour le soumettre
    form.addEventListener('submit', function(event) {
      // Vérification des saisies
      var nameInput = document.getElementById('name');
      var emailInput = document.getElementById('email');
      var subjectInput = document.getElementById('subject');
      var messageInput = document.getElementById('message');

      var isValid = true;

      if (nameInput.value.trim() === '') {
        isValid = false;
        alert('Veuillez entrer votre nom.');
      } else if (containsNumbers(nameInput.value.trim())) {
        isValid = false;
        alert('Le nom ne peut pas contenir des chiffres.');
      }

      if (emailInput.value.trim() === '') {
        isValid = false;
        alert('Veuillez entrer votre adresse email.');
      } else if (!isValidEmail(emailInput.value.trim())) {
        isValid = false;
        alert('Veuillez entrer une adresse email valide.');
      }

      if (subjectInput.value.trim() === '') {
        isValid = false;
        alert('Veuillez entrer le sujet de votre message.');
      }

      if (messageInput.value.trim() === '') {
        isValid = false;
        alert('Veuillez entrer votre message.');
      }

      if (isValid) {
        form.removeEventListener('submit', submitHandler);
        form.submit();
      } else {

        event.preventDefault();
      }
    });
  };

  function isValidEmail(email) {
    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  }

  function containsNumbers(input) {
    return /\d/.test(input);
  }
</script>
