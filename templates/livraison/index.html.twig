{% extends 'base.html.twig' %}

{% block title %}Livraison index{% endblock %}

{% block body %}
    <h1>Livraison index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code_pin</th>
                <th>Livraison_date</th>
                <th>Frais_livraison</th>
                <th>Prix_totale_livraison</th>
                <th>Reference</th>
                <th>Poid_livraison</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for livraison in livraisons %}
            <tr>
                <td>{{ livraison.id }}</td>
                <td>{{ livraison.codePin }}</td>
                <td>{{ livraison.livraisonDate ? livraison.livraisonDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ livraison.fraisLivraison }}</td>
                <td>{{ livraison.prixTotaleLivraison }}</td>
                <td>{{ livraison.reference }}</td>
                <td>{{ livraison.poidLivraison }}</td>
                <td>
                    <a href="{{ path('app_livraison_show', {'id': livraison.id}) }}">show</a>
                    <a href="{{ path('app_livraison_edit', {'id': livraison.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_livraison_new') }}">Create new</a>
{% endblock %}
