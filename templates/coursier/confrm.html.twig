<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
    }

    .containerm {
        max-width: 600px;
        margin: 50px auto;
       height: 400px; /* Increased height of the container */
        background-color: #fff;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h1 {
        text-align: center;
    }

    .button-container {
        display: flex;
        justify-content: space-between; 
        /* Space buttons evenly */
        margin-bottom: 20px; /* Added margin at bottom */
    }

    .button {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

    .confirm-normal {
        background-color: #4caf50;
        color: #fff;
    }

    .confirm-with-pin {
        background-color: #007bff;
        color: #fff;
    }

    input[type="text"] {
        width: 200px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 16px;
        margin: 0 auto; /* Center input horizontally */
        display: block; /* Display input as block element */
    }

    .divider {
        border-right: 1px solid #ccc; /* Vertical line between buttons and input */
        height: 60px; /* Adjust height as needed */
        margin: 0 20px; /* Added margin around divider */
    }
    .button-container{
       display:flex;
       justify-content: center;
       align-items: center;
       justify-content: space-between;
    

    }.containerm{
       display:flex;
       justify-content: center;
       align-items: center;
       

    }
  .containerm {
    display: flex;
    justify-content: center;
    align-items: center;
    
}

.content {
    text-align: center;
    margin: 50px; /* Optional: Add margin for spacing between content */
}
.containerm.ff {
 
    height: 10vh; /* Optional: Set the height to fill the viewport */
}
</style>
</head>
<body>
   <form id="myForm" method="post" action="{{ path('confirmsubmit') }}" >
    <div class="containerm ff">  <h1>choisir un type de confirmation </h1>  </div>
   <div class="containerm">
   
   
        
     <div  class="content">
            <button  value="normal" name="submit_button" type="submit" class="button confirm-normal">Confirm</button>
 </div>
        <div  class="content">
            <button value="pin" name="submit_button" type="submit"  class="button confirm-with-pin">Confirm with PIN</button></br></br>
            <input type="text" name="pin" id="pin" placeholder="Enter PIN">
           <input type="hidden" name="livraisonId" id="livraisonId" value="{{ livraisonId }}"><br />
    </div>

    
   
    </div> </form>
   {% if error == 1 %}
