  .containert {
    width: 80%;
    margin: 50px auto;
  
  
    padding: 20px;
  }

  .section {
  width: 80%;
    margin: 50px auto;
    background-color: #f9f9f9;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(100px, auto);
    gap: 20px;
       margin-bottom: 60px; 
  }
  .infot {
    width: 100%;
  }

  label {
    font-weight: bold;
  }
    .infot:hover {
    background-color: #f0f0f0;
    transition: background-color 0.3s ease;
  }
    h2 {
    margin-bottom: 60px; /* Add more space between h2 and sections */
  }
</style>
</head>
<body>

<div class="containert">

  <div class="section">
    <h2>Informations de livraison</h2>
    <div>
      <label></label>
      <p></p>
    </div>
    <div class="infot">
      <label>Référence:</label>
      <p>{{ liv.getReference() }}</p>
    </div>
    <div class="infot">
      <label>ID:</label>
      <p>{{ liv.getId() }}</p>
    </div>
    <div class="infot">
      <label>Code PIN:</label>
      <p>{{ liv.getCodePin() }}</p>
    </div>
    <div class="infot">
      <label>Frais de livraison:</label>
      <p>{{ liv.getFraisLivraison() }}</p>
    </div>
    <div class="infot">
      <label>Prix total de livraison:</label>
      <p>{{ liv.getPrixTotaleLivraison() }}</p>
    </div>
    <div class="infot">
      <label>Poids de livraison:</label>
      <p>{{ liv.getPoidLivraison() }}</p>
    </div>
    <div class="infot">
      <label>Date de livraison:</label>
      <p>{{ liv.getLivraisonDate()|date('Y-m-d ') }}</p>
    </div>
    {% if liv.getTourner() is not null %}
    <div class="infot">
      <label>ID du tourner:</label>
      <p>{{ liv.getTourner().getId() }}</p>
    </div>
    {% endif %}
  </div>


  <div class="section">
    <h2>informations de client</h2>
       <div>
      <label></label>
      <p></p>
    </div>
    <div class="infot">
      <label>nom:</label>
      <p>{{client.nom}}</p>
    </div>
    <div class="infot">
      <label>prenom:</label>
      <p>{{ client.prenom }}</p>
    </div>
    <div class="infot">
      <label> email:</label>
      <p>{{ client.email }}</p>
    </div>
    <div class="infot">
      <label>numero de telephone:</label>
      <p>{{ client.phone }}</p>
    </div>
    
  </div>


  <div class="section">
    <h2>addresse</h2>
       <div >
      <label></label>
      <p></p>
    </div>
    {% for addres in address %}
    <div class="infot">
      <label>FormattedAddress:</label>
      <p>{{ addres.getFormattedAddress()}}</p>
    </div>
      <div class="infot">
      <label>Ville:</label>
      <p>{{ addres.getVille()}}</p>
    </div>
    
    <div class="infot">
      <label>Longitude:</label>
      <p>{{ addres.getLongitude()}}</p>
    </div>
   <div class="infot">
      <label>Latitude:</label>
      <p>{{ addres.getLatitude()}}</p>
    </div>
    <div class="infot">
      <label>Region:</label>
      <p>{{ addres.getVille()}}</p>
    </div>
    <div class="infot">
      <label>ZipCode:</label>
      <p>{{ addres.getZipCode()}}</p>
    </div>
    {% endfor %}
  </div>
</div>
