          margin-left: 10px;
      }

      .notification-item-wrapper h5 {
          margin: 0;
      }

      .notification-item-wrapper p {
          margin: 5px 0;
      }
      .dropdown-menu {
          width: 500px; 
          margin-left: 10px;
      }
